{
    "name": "zerofront/module-zero-redirects",
    "description": "Zero for Magento Open Source: a log of the storefront's 404s, most asked for first, and a 301 redirect for each in one click, with a suggested target from the catalog.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "redirects",
        "404",
        "seo"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-store": "*",
        "magento/module-url-rewrite": "*"
    },
    "replace": {
        "fixstacks/module-zero-redirects": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\Redirects\\": ""
        }
    }
}
